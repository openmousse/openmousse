{
 "name": "pantry",
 "version": 1,
 "title": {"zh": "家里的库存", "en": "Pantry"},
 "summary": {"zh": "拍小票（或把电子小票转过来）记下买了什么；快过期的、常备的快没了、这周买菜花了多少，看板上一眼看到。",
             "en": "Snap a receipt (or forward an e-receipt) and it records what you bought; what's about to expire, which staples are running low and what groceries cost this week, at a glance."},
 "for": ["diet"],
 "guide": "GUIDE.md",
 "tables": [
  {"name": "pantry", "title": {"zh": "家里的食物", "en": "Pantry"},
   "fields": [
    {"key": "name", "label": {"zh": "名字", "en": "Name"}, "type": "text", "required": true},
    {"key": "qty", "label": {"zh": "数量", "en": "Qty"}, "type": "number"},
    {"key": "unit", "label": {"zh": "单位", "en": "Unit"}, "type": "text"},
    {"key": "category", "label": {"zh": "类别", "en": "Category"}, "type": "choice",
     "options": {"zh": ["肉蛋", "奶", "蔬果", "主食", "零食", "饮品", "调料", "其他"],
                 "en": ["Meat & eggs", "Dairy", "Fruit & veg", "Staples", "Snacks", "Drinks", "Condiments", "Other"]}},
    {"key": "price", "label": {"zh": "价格", "en": "Price"}, "type": "money", "currency": "GBP"},
    {"key": "bought", "label": {"zh": "买的日期", "en": "Bought"}, "type": "date"},
    {"key": "expires", "label": {"zh": "到期", "en": "Expires"}, "type": "date"},
    {"key": "store", "label": {"zh": "哪买的", "en": "Store"}, "type": "text"},
    {"key": "staple", "label": {"zh": "常备（用完要补）", "en": "Staple (restock when out)"}, "type": "bool"},
    {"key": "min_qty", "label": {"zh": "剩几份就该补", "en": "Restock at"}, "type": "number"},
    {"key": "protein_g", "label": {"zh": "蛋白质", "en": "Protein"}, "type": "number", "unit": "g"},
    {"key": "note", "label": {"zh": "备注", "en": "Note"}, "type": "text"}
   ]}
 ],
 "blocks": [
  {"id": "expiring", "type": "list", "title": {"zh": "快过期", "en": "Expiring soon"}, "after": "diet.next",
   "source": {"from": "pantry", "where": [["qty", ">", 0], ["expires", "<=", "+3d"]], "sort": ["expires"]},
   "row": {"title": "{name} · {qty} {unit}", "right": "expires",
           "badge": [{"field": "expires", "op": "<=", "value": "today", "text": {"zh": "今天到期", "en": "Today"}, "tone": "bad"},
                     {"field": "expires", "op": "<=", "value": "+1d", "text": {"zh": "明天到期", "en": "Tomorrow"}, "tone": "warn"}]},
   "rowActions": [{"label": {"zh": "用掉 1 份", "en": "Used 1"}, "set": {"qty": "-1"}}], "edit": true,
   "empty": {"zh": "这几天没有快过期的", "en": "Nothing expires in the next few days"}},
  {"id": "restock", "type": "list", "title": {"zh": "该补货了", "en": "Running low"}, "after": "diet.shopping",
   "source": {"from": "pantry", "where": [["staple", "=", true], ["qty", "<=", {"field": "min_qty", "default": 0}]], "sort": ["category", "name"]},
   "row": {"title": "name", "right": "{qty} {unit}",
           "badge": [{"field": "qty", "op": "<=", "value": 0, "text": {"zh": "没了", "en": "Out"}, "tone": "warn"}]},
   "style": "chips", "edit": true, "empty": {"zh": "没有快用完的常备品", "en": "No staples running low"}},
  {"id": "pantry", "type": "list", "title": {"zh": "家里有什么", "en": "In the pantry"}, "after": "diet.shopping",
   "source": {"from": "pantry", "where": [["qty", ">", 0]], "sort": ["category", "expires"]},
   "row": {"title": "{name} · {qty} {unit}", "sub": ["note"], "right": "expires"},
   "group": "category", "limit": 20, "edit": true,
   "rowActions": [{"label": {"zh": "用掉 1 份", "en": "Used 1"}, "set": {"qty": "-1"}}],
   "empty": {"zh": "库存空了，拍张小票给我", "en": "Nothing recorded yet: snap a receipt"}},
  {"id": "pantry_actions", "type": "action", "title": "", "after": "pantry",
   "actions": [{"kind": "upload", "label": {"zh": "拍小票", "en": "Snap a receipt"}, "message": {"zh": "这是今天的小票，记进库存", "en": "Here's today's receipt, add it to the pantry"},
                "accept": ["camera", "photos", "files"], "primary": true},
               {"kind": "form", "label": {"zh": "记一样", "en": "Add an item"}, "collection": "pantry"},
               {"kind": "ask", "label": {"zh": "出采购单", "en": "Shopping list"}, "message": {"zh": "按库存出这周的采购单", "en": "Make this week's shopping list from the pantry"}}]},
  {"id": "grocery_spend", "type": "stat", "title": {"zh": "买菜花费", "en": "Grocery spend"}, "after": "pantry_actions",
   "items": [{"label": {"zh": "这周", "en": "This week"}, "value": {"from": "pantry", "agg": "sum", "field": "price", "where": [["bought", ">=", "week"]]},
              "compare": {"from": "pantry", "agg": "sum", "field": "price", "where": [["bought", ">=", "lastweek"], ["bought", "<", "week"]]},
              "compareLabel": {"zh": "比上周", "en": "vs last week"}, "good": "down"},
             {"label": {"zh": "这个月", "en": "This month"}, "value": {"from": "pantry", "agg": "sum", "field": "price", "where": [["bought", ">=", "month"]]}}]},
  {"id": "grocery_trend", "type": "chart", "title": {"zh": "每周买菜", "en": "Groceries by week"}, "after": "grocery_spend",
   "series": {"from": "pantry", "agg": "sum", "field": "price", "by": "week", "date": "bought", "range": "8w"}}
 ],
 "alerts": [
  {"id": "restock", "title": {"zh": "补货提醒", "en": "Restock reminder"},
   "why": {"zh": "周末采购前看一眼常备的哪些快没了，不用站在超市里想。", "en": "A look at which staples are running low before the weekend shop."},
   "source": {"from": "pantry", "where": [["staple", "=", true], ["qty", "<=", {"field": "min_qty", "default": 0}]], "sort": ["category", "name"]},
   "row": "{name}", "message": {"zh": "家里快没了：{items}", "en": "Running low: {items}"}, "at": "10:00", "days": ["sat"], "level": "quiet"},
  {"id": "expiring", "title": {"zh": "快过期提醒", "en": "Use-it-up reminder"},
   "why": {"zh": "明天到期的东西，前一晚提醒一句，免得放坏。", "en": "A nudge the evening before something expires, so it doesn't go to waste."},
   "source": {"from": "pantry", "where": [["qty", ">", 0], ["expires", "<=", "+1d"]], "sort": ["expires"]},
   "row": "{name}", "message": {"zh": "明天前到期：{items}", "en": "Use by tomorrow: {items}"}, "at": "18:00", "level": "quiet"}
 ]
}
