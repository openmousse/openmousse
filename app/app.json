{
  "expo": {
    "name": "OpenMousse",
    "slug": "openmousse",
    "version": "1.0.7",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.openmousse.ios",
      "buildNumber": "1",
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "NSHealthShareUsageDescription": "{name} 读取睡眠、心率变异性、静息心率等数据，用于每天的状态判断和训练建议。",
        "NSHealthUpdateUsageDescription": "{name} 不会向健康写入数据。",
        "ITSAppUsesNonExemptEncryption": false,
        "NSSupportsLiveActivities": true,
        "UIBackgroundModes": [
          "bluetooth-central"
        ]
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.healthkit.access": []
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "app.openmousse.android"
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "scheme": "openmousse",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "plugins": [
      [
        "@kingstinct/react-native-healthkit",
        {
          "NSHealthShareUsageDescription": "{name} 读取睡眠、心率变异性、静息心率等数据，用于每天的状态判断和训练建议。",
          "NSHealthUpdateUsageDescription": "{name} 不会向健康写入数据。",
          "background": true
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "{name} 需要用麦克风，把你说的话转成文字、录播客，以及拍视频时录下声音。",
          "enableBackgroundRecording": true
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "{name} 需要访问相册：把你选的照片发给它看，或在你要求时让它看最近拍的照片。",
          "cameraPermission": "{name} 需要用相机拍照、拍视频发给它看，以及扫描配对码和好友邀请码。",
          "microphonePermission": "{name} 需要用麦克风，把你说的话转成文字、录播客，以及拍视频时录下声音。"
        }
      ],
      "expo-asset",
      [
        "expo-notifications",
        {
          "color": "#D9AE62"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": "{name} 用面容 ID 确认是你本人，比如在你批准它替你做重要的事之前。"
        }
      ],
      "@bacons/apple-targets",
      "./plugins/withExtensionVersions",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "{name} 需要用相机拍照、拍视频发给它看，以及扫描配对码和好友邀请码。",
          "microphonePermission": "{name} 需要用麦克风，把你说的话转成文字、录播客，以及拍视频时录下声音。",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      [
        "expo-video",
        {
          "supportsBackgroundPlayback": false,
          "supportsPictureInPicture": false
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing",
      [
        "react-native-ble-manager",
        {
          "isBleRequired": false,
          "neverForLocation": true,
          "companionDeviceEnabled": false,
          "bluetoothAlwaysPermission": "{name} 用蓝牙连接你的 Flipper 等硬件设备。"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "{name} 在你打开「这台手机 → 定位」后，只在 app 开着时读取位置，用来回答你让它查的事。",
          "locationAlwaysAndWhenInUsePermission": "{name} 只在 app 开着时读取位置，不在后台定位。",
          "locationAlwaysPermission": false,
          "motionUsagePermission": "{name} 在你要求时读取步数和运动数据，用于活动记录和训练建议。",
          "isIosBackgroundLocationEnabled": false,
          "isAndroidBackgroundLocationEnabled": false,
          "isAndroidForegroundServiceEnabled": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "{name} 需要用麦克风，把你说的话转成文字、录播客，以及拍视频时录下声音。",
          "speechRecognitionPermission": "{name} 用系统的语音识别把你说的话转成文字，用在听写和对讲里。"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "{name} 需要访问相册：把你选的照片发给它看，或在你要求时让它看最近拍的照片。",
          "savePhotosPermission": "{name} 把你要保存的图片和视频存进相册，比如它做的图和分享卡片。",
          "isAccessMediaLocationEnabled": false,
          "preventAutomaticLimitedAccessAlert": true,
          "granularPermissions": [
            "photo",
            "video"
          ]
        }
      ],
      [
        "expo-calendar",
        {
          "calendarPermission": "{name} 在你要求时查看或添加日历里的日程，比如安排今天、把约好的事记进日历。",
          "remindersPermission": "{name} 在你要求时查看或添加提醒事项，比如把要做的事记成提醒。"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "{name} 在你要求时查找或添加联系人，比如查某人的电话、把名片存进通讯录。"
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "{name} 在你要求时读取步数和运动数据，用于活动记录和训练建议。"
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "{name} 用面容 ID 确认是你本人，比如在你批准它替你做重要的事之前。"
        }
      ]
    ]
  }
}
